# Application
APP_NAME=NichePerfumeTracker
DEBUG=true
SECRET_KEY=sua-chave-secreta-aqui

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/perfume_tracker

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# Scraping
SCRAPE_INTERVAL_HOURS=6
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=2

# Email (SendGrid)
SENDGRID_API_KEY=sua-api-key
EMAIL_FROM=alerts@seusite.com
